// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String  @id
  name              String
  email             String  @unique
  password          String
  role              String
  githubAccessToken String?
  repoAccess        UserRepositoryAccess[]
  githubAccounts    GitHubAccount[]
  userRoles         UserRole[]
  syncJobs          SyncJob[]
}

model Role {
  id    String @id
  name  String @unique
  users UserRole[]
}

model UserRole {
  id     String @id
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
}

model GitHubAccount {
  id          String   @id
  userId      String
  provider    String
  login       String
  email       String?
  accessToken String
  lastFullSyncAt DateTime?
  lastDailySyncAt DateTime?
  lastManualSyncAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, login])
  @@index([userId])
}

model Repository {
  id             String  @id
  provider       String
  providerRepoId String
  name           String
  fullName       String
  isPrivate      Boolean
  ownerLogin     String
  defaultBranch  String?
  lastProviderUpdatedAt DateTime?
  lastSyncedAt DateTime?
  lastCommitSyncedAt DateTime?
  lastPrUpdatedAt DateTime?
  lastReviewSyncedAt DateTime?
  fullBackfillCompleted Boolean @default(false)
  syncLockUntil DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  access         UserRepositoryAccess[]
  commitEvents   CommitEvent[]
  pullEvents     PullRequestEvent[]
  reviewEvents   ReviewEvent[]
  metricSnapshots MetricSnapshot[]

  @@unique([provider, providerRepoId])
}

model SyncJob {
  id         String   @id
  userId     String
  kind       String
  status     String
  startedAt  DateTime
  finishedAt DateTime?
  error      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([createdAt])
}

model UserRepositoryAccess {
  id           String   @id
  userId       String
  repositoryId String
  grantedAt    DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id])
  repository   Repository @relation(fields: [repositoryId], references: [id])

  @@unique([userId, repositoryId])
}

model CommitEvent {
  id            String   @id
  repositoryId  String
  sha           String
  authorLogin   String?
  authorEmail   String?
  message       String?
  committedAt   DateTime
  createdAt     DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id])

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
}

model PullRequestEvent {
  id           String   @id
  repositoryId String
  number       Int
  githubId     BigInt
  title        String
  state        String
  isMerged     Boolean
  authorLogin  String?
  createdAt    DateTime
  closedAt     DateTime?
  mergedAt     DateTime?
  updatedAt    DateTime?
  additions    Int?
  deletions    Int?
  changedFiles Int?

  repository Repository @relation(fields: [repositoryId], references: [id])

  @@unique([repositoryId, number])
  @@index([repositoryId, createdAt])
  @@index([repositoryId, closedAt])
  @@index([repositoryId, mergedAt])
}

model ReviewEvent {
  id           String   @id
  repositoryId String
  pullNumber   Int
  githubId     BigInt
  reviewerLogin String?
  state        String
  submittedAt  DateTime
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id])

  @@unique([repositoryId, githubId])
  @@index([repositoryId, submittedAt])
  @@index([repositoryId, pullNumber])
}

model MetricSnapshot {
  id                   String   @id
  repositoryId         String
  window               String
  from                 DateTime
  to                   DateTime
  meanCommitsPerWeek   Float?
  meanPrCycleTimeHours Float?
  prRejectionRate      Float?
  linesAdded           Int?
  linesDeleted         Int?
  netLines             Int?
  productivityScore    Float?
  createdAt            DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id])

  @@index([repositoryId, window, from, to])
}
